{
  "DocumentStorage": {
    "Root": "App_Data/Documents",
    "MaxFileSize": 26214400,
    "ScannerMode": "clean",
    "AllowedExtensions": [ ".pdf", ".doc", ".docx", ".xls", ".xlsx", ".ppt", ".pptx", ".txt", ".jpg", ".jpeg", ".png" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
